# iOS specific
#

# (str) Path to a custom kivy-ios folder
#ios.kivy_ios_dir = ../kivy-ios

# (str) Path to your custom SDL Xcode project template
#ios.sdl_xcode_project_dir = ../kivy-ios/sdl-xcode-template

